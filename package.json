{
  "name": "prometeo",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:windows": "tauri build --bundles nsis && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Mode all",
    "build:portable": "tauri build --no-bundle && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Mode portable",
    "build:linux": "tauri build --bundles deb,appimage && bash scripts/package-linux.sh",
    "build:macos": "tauri build --bundles dmg && bash scripts/package-macos.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
