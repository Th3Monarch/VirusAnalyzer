{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prometeo",
  "version": "2.1.0",
  "mainBinaryName": "Prometeo",
  "identifier": "com.prometeo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-app"
  },
  "app": {
    "windows": [
      {
        "title": "Prometeo 2.1",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMTlDRkIxQ0RENjE0QkEKUldTNkZOYk5zYzhaTGh4Z2JGWDJwQ0FSNjVWVGdUazdFeTNETTVkaUtyVlA1Y2haa1B0cDR3aXYK",
      "endpoints": [
        "https://github.com/Th3Monarch/prometeo/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "publisher": "Prometeo",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign.ps1",
          "%1"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libappindicator3-1"],
        "section": "utils"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
